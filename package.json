{
    "name": "glassops",
    "version": "1.0.0",
    "private": true,
    "description": "Governance-first Salesforce DevOps",
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@11.2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/glassops-platform/glassops.git"
    },
    "bugs": {
        "url": "https://github.com/glassops-platform/glassops/issues"
    },
    "scripts": {
        "docs:setup": "python -m pip install --user -r config/requirements.txt",
        "docs:build": "npm run docs:setup && python scripts/build-docs.py",
        "docs:serve": "npm run docs:setup && python scripts/build-docs.py && python -m mkdocs serve -f docs_staging/mkdocs.yml",
        "docs:generate-map": "node scripts/verify-docs.js generate",
        "docs:validate": "node scripts/verify-docs.js",
        "docs:regen": "node scripts/verify-docs.js generate && node scripts/verify-docs.js",
        "runtime:build": "shx mkdir -p dist && cd packages/runtime && go build -o ../../dist/glassops.exe ./cmd/glassops/main.go",
        "runtime:test": "cd packages/runtime && go test -v ./...",
        "precommit": "npm run docs:validate",
        "prepare": "husky"
    },
    "devDependencies": {
        "@prettier/plugin-xml": "^3.4.1",
        "@secretlint/secretlint-rule-pattern": "^13.1.0",
        "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
        "husky": "^9.1.7",
        "prettier": "^3.5.3",
        "prettier-plugin-apex": "^2.2.6",
        "secretlint": "^13.1.0",
        "shx": "^0.4.0"
    },
    "author": "Ryan Bumstead",
    "license": "Apache-2.0",
    "dependencies": {
        "fast-levenshtein": "^3.0.0",
        "ignore": "^7.0.5"
    }
}
