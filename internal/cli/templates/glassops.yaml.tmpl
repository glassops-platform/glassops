# glassops.yaml: configuration for the glassops CLI.
# Schema: https://github.com/glassops-platform/glassops/blob/main/schemas/config.json
version: 1
{{- if .Provider }}
provider: {{ .Provider }}
{{- end }}

# Targets are where changes go. Uncomment and fill in one block per target.
# Secrets are named with $VAR, so the values stay in your CI's secret store.
# targets:
#   prod:
#     id: 00D000000000000            # org Id guard: login must land on this org
#     tier: prod
#     branch: main
#     auth: { method: jwt, username: $SF_PROD_USERNAME, client_id: $SF_CLIENT_ID, key: $SF_JWT_KEY }

# Policy is evaluated by glassops gate before anything changes a target.
# policy:
#   windows:
#     prod: [{ days: [tue, thu], from: "18:00", to: "22:00", tz: America/Chicago }]
#   rules:
#     coverage_min: 75

pipelines:
  pr:
    - plan
    - check
    - analyze
    - env create --from devhub --ttl 1
    - validate --target ephemeral --fallback-target prod --check-only
    - test --target ephemeral
    - report
    - step: env delete
      when: always
  deploy:
    - plan
    - analyze
    - gate --target prod
    - deploy --target prod
    - verify --target prod
    - report
