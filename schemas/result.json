{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/glassops-platform/glassops/schemas/result.json",
  "title": "glassops step result",
  "description": "The envelope every glassops command writes to .glassops/results/<step>.json.",
  "type": "object",
  "required": ["schema", "step", "status", "started", "ended", "facts", "artifacts", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "glassops.result/v1" },
    "step": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail", "error", "skipped", "empty"] },
    "started": { "type": "string", "format": "date-time" },
    "ended": { "type": "string", "format": "date-time" },
    "target": { "type": "string" },
    "provider": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail", "error", "skipped", "empty"] },
          "detail": { "type": "string" }
        }
      }
    },
    "facts": { "type": "object" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
